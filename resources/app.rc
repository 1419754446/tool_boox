#include <windows.h>

// 版本号来自工程根的 version.txt，build.ps1 生成 version_rc.h 并用 -Ibuild 让
// windres 找到它；这里不再手写数字，避免 exe 属性与程序内版本号对不上。
#include "version_rc.h"

1 RT_MANIFEST "app.manifest"
1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION TB_VER_NUM
PRODUCTVERSION TB_VER_NUM
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Toolbox"
      VALUE "FileDescription", "Toolbox - Windows utility launcher"
      VALUE "FileVersion", TB_VERSION_STR
      VALUE "InternalName", "Toolbox"
      VALUE "OriginalFilename", "Toolbox.exe"
      VALUE "ProductName", "Toolbox"
      VALUE "ProductVersion", TB_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
